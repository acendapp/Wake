# Wake — copy this file to `.env` and fill in your Supabase values.
# Find them in the Supabase dashboard → Project Settings → API.
# EXPO_PUBLIC_ vars are bundled into the client build (safe for the anon key,
# NEVER the service_role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK key (billing). Dashboard → Project → API keys → the iOS
# "public" app key (starts with `appl_`). Leave blank to run the dev entitlement
# mock (Expo Go / keyless testing). Android key added later when we ship Android.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
