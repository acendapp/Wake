{
  "expo": {
    "name": "Wake",
    "slug": "wake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wake",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.acendapp.wake",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "Wake schedules a gentle voice alarm to wake you at the time you choose."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wake uses your location to show the local weather on your morning screen."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "expo-audio",
      "expo-notifications",
      "./plugins/withWakeAudio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a621681c-9bf0-40c7-838f-54700a3e7aa7"
      }
    },
    "owner": "anikweduru"
  }
}
